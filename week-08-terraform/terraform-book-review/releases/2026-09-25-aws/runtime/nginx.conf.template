pid /run/book-nginx/nginx.pid;
error_log stderr crit;
worker_processes auto;
events { worker_connections 1024; }
http {
    map_hash_bucket_size 256;
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    server_tokens off;
    client_max_body_size 64k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    send_timeout 10s;
    keepalive_timeout 15s;
    client_body_temp_path /run/book-nginx/client;
    proxy_temp_path /run/book-nginx/proxy;
    fastcgi_temp_path /run/book-nginx/fastcgi;
    uwsgi_temp_path /run/book-nginx/uwsgi;
    scgi_temp_path /run/book-nginx/scgi;
    resolver 127.0.0.53 valid=30s ipv6=off;
    resolver_timeout 3s;
    limit_req_zone $binary_remote_addr zone=auth:1m rate=5r/s;
    map "$host|$http_x_forwarded_proto" $direct_origin {
        default 0;
        "@@PUBLIC_HOST@@|https" 1;
    }
    # API Gateway overwrites viewer metadata; ALB admits only the VPC-link SG.
    # Requiring ALB's HTTP marker keeps this branch separate from direct HTTPS.
    map "$http_x_forwarded_proto|$http_x_a5_viewer_host|$http_x_a5_viewer_proto" $gateway_origin {
        default 0;
        "http|@@PUBLIC_HOST@@|https" 1;
    }
    map "$direct_origin|$gateway_origin" $approved_origin {
        default 0;
        "1|0" 1;
        "0|1" 1;
        "1|1" 1;
    }
    map $uri $api_path {
        default "";
        ~^/(?:api/)?(?<api_suffix>(?:books|users|reviews)(?:/.*)?)$ /api/$api_suffix;
    }
    server {
        listen 80 default_server;
        server_name @@PUBLIC_HOST@@;
        set $internal_origin "@@INTERNAL_URL@@";
        proxy_connect_timeout 3s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host "@@INTERNAL_HOST@@";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_intercept_errors on;
        error_page 500 502 503 504 =503 /_book_error;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        location = /_book_error { internal; default_type text/plain; return 503 "unavailable\n"; }
        location ^~ /_next/image { return 404; }
        location = /healthz {
            if ($request_method !~ ^(GET|HEAD)$) { return 405; }
            proxy_pass http://127.0.0.1:3002/healthz;
            proxy_read_timeout 8s;
            proxy_set_header Authorization "";
            proxy_set_header Cookie "";
        }
        location ~ ^/(?:api/)?books(?:/[0-9]+)?/?$ {
            if ($approved_origin = 0) { return 421; }
            if ($request_method !~ ^(GET|HEAD)$) { return 405; }
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Host "@@INTERNAL_HOST@@";
            proxy_set_header Connection "";
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Cookie "";
            proxy_set_header Authorization "";
            proxy_pass $internal_origin$api_path$is_args$args;
        }
        location ~ ^/(?:api/)?users/(?:register|login)/?$ {
            if ($approved_origin = 0) { return 421; }
            if ($request_method != POST) { return 405; }
            client_max_body_size 16k;
            limit_req zone=auth burst=10 nodelay;
            proxy_pass $internal_origin$api_path$is_args$args;
        }
        location ~ ^/(?:api/)?reviews/[0-9]+/?$ {
            if ($approved_origin = 0) { return 421; }
            if ($request_method !~ ^(GET|HEAD)$) { return 405; }
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Host "@@INTERNAL_HOST@@";
            proxy_set_header Connection "";
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Cookie "";
            proxy_set_header Authorization "";
            proxy_pass $internal_origin$api_path$is_args$args;
        }
        location ~ ^/(?:api/)?reviews/?$ {
            if ($approved_origin = 0) { return 421; }
            if ($request_method != POST) { return 405; }
            proxy_set_header Host "@@INTERNAL_HOST@@";
            proxy_set_header Connection "";
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Cookie "";
            proxy_set_header Authorization $http_authorization;
            proxy_pass $internal_origin$api_path$is_args$args;
        }
        location ~ ^/(?:api|books|users|reviews)(?:/|$) { return 404; }
        location / {
            if ($approved_origin = 0) { return 421; }
            if ($request_method !~ ^(GET|HEAD)$) { return 405; }
            proxy_set_header Host "@@PUBLIC_HOST@@";
            proxy_set_header Connection "";
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Authorization "";
            proxy_set_header Cookie "";
            proxy_pass http://127.0.0.1:3000;
        }
    }
}
